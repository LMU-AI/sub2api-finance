# sub2api 数据库（只读数据源）—— 改成你自己的 sub2api 数据库连接信息
# 数据库不在本机时，可用 SSH 隧道：ssh -L 5432:<db-host>:5432 <user>@<bastion-host>
RDS_HOST=127.0.0.1
RDS_PORT=5432
RDS_USER=postgres
RDS_PASSWORD=
RDS_DB=sub2api

# 财务系统自有库（PostgreSQL，存快照/成本/设置）
# 本地测试用 docker：docker run -d --name lmuai-finance-pg \
#   -e POSTGRES_USER=finance -e POSTGRES_PASSWORD=finance -e POSTGRES_DB=finance \
#   -p 127.0.0.1:5544:5432 postgres:16-alpine
FINANCE_DB_HOST=127.0.0.1
FINANCE_DB_PORT=5544
FINANCE_DB_USER=finance
FINANCE_DB_PASSWORD=finance
FINANCE_DB_NAME=finance

# 登录密码（共享密码）
APP_PASSWORD=changeme
# 会话签名密钥（长随机字符串）
SESSION_SECRET=please-change-this-to-a-long-random-string
# 聚合任务 cron（默认每 30 分钟）
AGG_CRON=*/30 * * * *
